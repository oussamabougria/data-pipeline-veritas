# =============================================================================
# PROJECT VERITAS — Environment Variables
# Copy to .env, fill in secrets, NEVER commit .env to git.
# =============================================================================

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_SUPERUSER_PASSWORD=change_me_superuser
VERITAS_DB_PASSWORD=change_me_veritas

# ── Airflow ──────────────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=your_fernet_key_here
AIRFLOW_ADMIN_PASSWORD=change_me_admin

# ── Kafka KRaft ──────────────────────────────────────────────────────────────
# Generate once with: docker run --rm confluentinc/cp-kafka:7.5.0 kafka-storage random-uuid | base64
# Commit this value — it must stay stable across restarts.
KAFKA_CLUSTER_ID=your_base64_cluster_id_here

# ── MinIO (XCom blob store) ──────────────────────────────────────────────────
MINIO_ACCESS_KEY=veritas
MINIO_SECRET_KEY=change_me_minio

# ── Anthropic (Enrichment Path only — never used by Flink/Critical Path) ────
ANTHROPIC_API_KEY=sk-ant-...
